    },
    {
      "name": "Transactions",
      "short_name": "Transactions",
      "description": "Open transaction tracking.",
      "url": "./#/transactions",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Analytics",
      "short_name": "Analytics",
